<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pu="https://opensource.panuon.com/wpf-ui">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Oddob.Service;component/View/WpfTheme/PaunonColorLight.xaml" />
        <pu:StyleDictionary Includes="All" />
    </ResourceDictionary.MergedDictionaries>
    
    <!--默认按钮-->
    <Style x:Key="CheckBoxDefault" TargetType="CheckBox" BasedOn="{StaticResource {x:Static pu:StyleKeys.CheckBoxStyle}}">
        <Setter Property="Height" Value="{DynamicResource BodyHeight}" />
        <Setter Property="pu:CheckBoxHelper.CheckedCornerRadius" Value="{DynamicResource SmallCorner}" />
        <Setter Property="pu:CheckBoxHelper.CornerRadius" Value="{DynamicResource SmallCorner}" />
        <Setter Property="pu:CheckBoxHelper.CheckedBackground" Value="{DynamicResource PrimaryBrush}"></Setter>
        <Setter Property="pu:CheckBoxHelper.CheckedGlyphBrush" Value="{DynamicResource BackgroundBrush}"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"></Setter>
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness}"></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource ForegroundBrush}"></Setter>
    </Style>
    <Style x:Key="CheckBoxPrimary" TargetType="CheckBox" BasedOn="{StaticResource CheckBoxDefault}">
        <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"></Setter>
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    </Style>
</ResourceDictionary>