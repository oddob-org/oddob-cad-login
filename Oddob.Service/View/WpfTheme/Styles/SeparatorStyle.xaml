<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pu="https://opensource.panuon.com/wpf-ui">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Oddob.Service;component/View/WpfTheme/PaunonColorLight.xaml" />
        <pu:StyleDictionary Includes="All"></pu:StyleDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!--默认-->
    <Style x:Key="SeparatorDefault" TargetType="Separator">
        <Setter Property="BorderThickness"
                Value="{DynamicResource BorderThickness}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Height"
                Value="0.9"/>
    </Style>
</ResourceDictionary>