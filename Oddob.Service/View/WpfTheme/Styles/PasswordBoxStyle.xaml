<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pu="https://opensource.panuon.com/wpf-ui">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Oddob.Service;component/View/WpfTheme/PaunonColorLight.xaml" />
        <pu:StyleDictionary Includes="All"></pu:StyleDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!--默认-->
    <Style x:Key="PasswordBoxDefault" TargetType="PasswordBox" BasedOn="{StaticResource {x:Static pu:StyleKeys.PasswordBoxStyle}}">
        <Setter Property="pu:PasswordBoxHelper.FocusedBorderBrush"
                Value="#0099FF" />
        <Setter Property="pu:PasswordBoxHelper.FocusedShadowColor"
                Value="#0099FF" />
        <Setter Property="pu:PasswordBoxHelper.CornerRadius"
                Value="{DynamicResource SmallCorner}" />
        <Setter Property="pu:PasswordBoxHelper.WatermarkForeground"
                Value="{DynamicResource LightForegroundBrush}" />
        <Setter Property="pu:PasswordBoxHelper.FocusedWatermarkForeground"
                Value="#AAAAAA" />
        <Setter Property="Height"
                Value="{DynamicResource BodyHeight}" />
        <Setter Property="Padding"
                Value="10,0" />
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource BorderThickness}" />
    </Style>

</ResourceDictionary>