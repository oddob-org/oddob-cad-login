<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pu="https://opensource.panuon.com/wpf-ui">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Oddob.Service;component/View/WpfTheme/PaunonColorLight.xaml" />
        <pu:StyleDictionary Includes="All" />
    </ResourceDictionary.MergedDictionaries>

    <!--默认-->
    <Style x:Key="TextBoxDefault" TargetType="TextBox" BasedOn="{StaticResource {x:Static pu:StyleKeys.TextBoxStyle}}">
        <Setter Property="pu:TextBoxHelper.FocusedBorderBrush"
                Value="#0099FF" />
        <Setter Property="pu:TextBoxHelper.FocusedShadowColor"
                Value="#0099FF" />
        <Setter Property="pu:TextBoxHelper.CornerRadius"
                Value="{StaticResource SmallCorner}" />
        <Setter Property="pu:TextBoxHelper.WatermarkForeground"
                Value="{DynamicResource LightForegroundBrush}" />
        <Setter Property="pu:TextBoxHelper.FocusedWatermarkForeground"
                Value="#AAAAAA" />
        <Setter Property="Height"
                Value="{DynamicResource BodyHeight}" />
        <Setter Property="Padding"
                Value="10,0" />
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource BorderThickness}" />
    </Style>
</ResourceDictionary>