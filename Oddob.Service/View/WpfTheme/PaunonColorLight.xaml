<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--背景-->
    <SolidColorBrush x:Key="BackgroundBrush">#FFFFFF</SolidColorBrush>
    <!--文字颜色-->
    <SolidColorBrush x:Key="ForegroundBrush">#1E1E1E</SolidColorBrush>
    <!--提示-->
    <SolidColorBrush x:Key="LightForegroundBrush">#8E8E8E</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#AA000000</SolidColorBrush>

    <!--通知背景-->
    <SolidColorBrush x:Key="ToastBackground">#1E1E1E</SolidColorBrush>
    <!--通知文字-->
    <SolidColorBrush x:Key="ToastForeground">#FFFFFF</SolidColorBrush>

    <!--强调颜色-->
    <Color x:Key="PrimaryColor">#0099FF</Color>
    <SolidColorBrush x:Key="PrimaryBrush">#0099FF</SolidColorBrush>

    <!--尺寸变量-->
    <system:Double x:Key="BodyHeight">35</system:Double>
    <CornerRadius x:Key="SmallCorner">4</CornerRadius>
    <CornerRadius x:Key="BigCorner">8</CornerRadius>
    <Thickness x:Key="BorderThickness">1</Thickness>
</ResourceDictionary>