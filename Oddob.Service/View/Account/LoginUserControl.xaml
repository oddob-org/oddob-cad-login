<Page x:Class="Oddob.Service.View.Account.LoginUserControl"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:Oddob.Service.ViewModel.Account"
      xmlns:pu="https://opensource.panuon.com/wpf-ui"
      xmlns:iw="clr-namespace:Oddob.Service.View.Converter"
      xmlns:uc="clr-namespace:Oddob.Service.View.Controls"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
      d:DesignHeight="500" d:DesignWidth="350"
      Loaded="LoginUserControl_OnLoaded">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Oddob.Service;component/View/WpfTheme/PanuonUiThemeDefaultResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <iw:Bool2VisibilityHiddenConverter x:Key="Bool2VisibilityHiddenConverter" />
            <!-- <iw:Bool2VisibilityConverter x:Key="Bool2VisibilityConverter" /> -->
        </ResourceDictionary>
    </Page.Resources>
    <Border Background="Transparent" >
        <uc:AutoGrid Margin="10" Columns="*" Rows="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ChildMargin="5">
            <uc:AutoGrid Rows="Auto" Columns="*,Auto,Auto,*" Margin="0" ChildMargin="5">
                <Label/>
                <Image Source="../../Resources/logo.png" Height="48"/>
                <Label Content="oddob" FontSize="50"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       VerticalAlignment="Stretch" Height="Auto" />
                <Label/>
            </uc:AutoGrid>
            <TextBox Text="{Binding Path=AccountNumber,UpdateSourceTrigger=PropertyChanged}"
                     pu:TextBoxHelper.Watermark="账号"
                     pu:TextBoxHelper.Icon="&#xe632;"
                     pu:IconHelper.FontFamily="{StaticResource IconFont}"
                     pu:TextBoxHelper.ClearButtonVisibility="VisibleOnHoverAndNonnull" />
            <PasswordBox pu:PasswordBoxHelper.Watermark="密码"
                         pu:PasswordBoxHelper.Password="{Binding Path=Password,UpdateSourceTrigger=PropertyChanged}"
                         pu:PasswordBoxHelper.Icon="&#xe7b8;"
                         pu:IconHelper.FontFamily="{StaticResource IconFont}"
                         pu:PasswordBoxHelper.PlainButtonVisibility="Visible" />
            <uc:AutoGrid Columns="*,Auto" ChildMargin="5">
                <pu:Switch Content="记住密码"
                           IsChecked="{Binding  Path=RememberPassword}"
                           Style="{StaticResource SwitchDefault}" />
                <Button Content="忘记密码？" HorizontalAlignment="Right"
                        Foreground="#8E8E8E"
                        BorderThickness="0"
                        Background="{DynamicResource BackgroundBrush}"
                        pu:ButtonHelper.HoverForeground="{DynamicResource PrimaryBrush}"
                        Command="{Binding Path=ResetPasswordCommand}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextDecorations="Underline" />
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </uc:AutoGrid>
            <uc:AutoGrid Columns="6*,3*" Rows="Auto,Auto" ChildMargin="5" Margin="0"
                         Visibility="{Binding Path=NeedVerification,Converter={StaticResource Bool2VisibilityHiddenConverter}}">
                <TextBox Grid.Column="0"
                         Text="{Binding Path=PngVerifyCode,UpdateSourceTrigger=PropertyChanged}"
                         pu:TextBoxHelper.Watermark="图片验证码"
                         pu:TextBoxHelper.Icon="&#xe600;"
                         pu:IconHelper.FontFamily="{StaticResource IconFont}"
                         pu:TextBoxHelper.ClearButtonVisibility="Collapsed" />
                <Button Grid.Column="1" BorderThickness="0" pu:ButtonHelper.CornerRadius="0"
                        MinWidth="120" Width="Auto" Command="{Binding Path= RefreshPngVerificationCodeCommand}">
                    <Button.Content>
                        <Image Source="{Binding Path=VerifyCodeImage}"/>
                    </Button.Content>
                </Button>
                <TextBox Grid.Column="0"
                         Text="{Binding Path=VerificationCode,UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding Path=NeedVerification,Converter={StaticResource Bool2VisibilityHiddenConverter}}"
                         pu:TextBoxHelper.Watermark="短信验证码"
                         pu:TextBoxHelper.Icon="&#xe619;"
                         pu:IconHelper.FontFamily="{StaticResource IconFont}" />
                <Button Grid.Column="1" MinWidth="80"
                        Content="{Binding Path=VerificationCodeSettings.ButtonText}"
                        Visibility="{Binding Path=NeedVerification,Converter={StaticResource Bool2VisibilityHiddenConverter}}"
                        Command="{Binding GetVerificationCodeCommand}"
                        HorizontalAlignment="Stretch" />
            </uc:AutoGrid>
            <Border></Border>
            <Label Content="{Binding Path=NoticeLabelStr}"
                   Foreground="Red"
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Visibility="Hidden" />
            <Button Content="登录" MinWidth="100"
                    pu:ButtonHelper.IsPending="{Binding Mode=OneWay,Path=IsLoginExecuting}"
                    Command="{Binding Path=LoginCommand}"
                    HorizontalAlignment="Stretch"
                    pu:ButtonHelper.ClickEffect="Sink"
                    Style="{StaticResource ButtonPrimary}">
                <pu:ButtonHelper.PendingSpinStyle>
                    <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
                    <Style TargetType="pu:Spin"
                           BasedOn="{StaticResource {x:Static pu:ButtonHelper.PendingSpinStyleKey}}">
                        <Setter Property="Margin" Value="0,0,10,0" />
                        <Setter Property="SpinStyle" Value="Ring2" />
                    </Style>
                </pu:ButtonHelper.PendingSpinStyle>
            </Button>
            <Button Content="没有账号？去注册" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"
                    Background="Transparent"
                    BorderThickness="0"
                    pu:ButtonHelper.HoverForeground="{DynamicResource PrimaryBrush}"
                    Command="{Binding Path=RegisterCommand}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextDecorations="Underline" />
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </uc:AutoGrid>
    </Border>
</Page>