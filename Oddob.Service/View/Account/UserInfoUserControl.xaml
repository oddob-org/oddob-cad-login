<Page x:Class="Oddob.Service.View.Account.UserInfoUserControl"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:uc="clr-namespace:Oddob.Service.View.Controls"
      xmlns:vm="clr-namespace:Oddob.Service.ViewModel.Account"
      xmlns:pu="https://opensource.panuon.com/wpf-ui"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:UserInfoViewModel}"
      d:DesignHeight="500" d:DesignWidth="350" Loaded="UserInfoUserControl_OnLoaded">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Oddob.Service;component/View/WpfTheme/PanuonUiThemeDefaultResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Border Background="Transparent">
        <uc:AutoGrid Columns="*" Rows="Auto,Auto,Auto,*,Auto,Auto" Margin="10" ChildMargin="5">
            <uc:AutoGrid Columns="Auto,Auto,Auto,*" Rows="Auto,Auto" Orientation="Vertical">
                <Image Grid.RowSpan="2" Source="{Binding Path=UserInfo.HeadImage}" Height="32" Width="32"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
                <TextBlock Text="{Binding Path=UserInfo.Username}" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Path=UserInfo.Level, StringFormat=Lv{0}}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Path=UserInfo.TypeString}" VerticalAlignment="Center" Margin="5,0" />
            </uc:AutoGrid>
            <uc:AutoGrid Rows="Auto" Columns="Auto,*,Auto,*" Margin="4" ChildMargin="1">
                <Label Content="&#xe6ee; 金币：" FontFamily="{StaticResource IconFont}" />
                <Label Content="{Binding Path=UserInfo.Money}" />
                <Label Content="&#xe768; 积分：" FontFamily="{StaticResource IconFont}" />
                <Label Content="{Binding Path=UserInfo.Score}" />
            </uc:AutoGrid>
            <uc:AutoGrid Margin="0,0,0,-5" ChildMargin="5,0" Columns="*,Auto" Rows="*">
                <Label Content="产品列表" />
                <Button MinHeight="0" Height="Auto" Content="&#xec08;" FontFamily="{StaticResource IconFont}"
                        pu:ButtonHelper.CornerRadius="1" Padding="2" BorderThickness="1" BorderBrush="Transparent"
                        ToolTip="刷新" Command="{Binding Path=RefreshCommand}"
                        pu:ButtonHelper.HoverBorderBrush="{StaticResource BorderBrush}" />
            </uc:AutoGrid>
            <Border BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                    <ItemsControl ItemsSource="{Binding Path=Products}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <uc:AutoGrid Rows="Auto" Columns="Auto,Auto,*">
                                    <Image Source="{Binding Path=Logo}" Height="30" Width="30"></Image>
                                    <Label Content="{Binding Path=Name}" />
                                    <Label Content="{Binding Path=OvertimeDate}">
                                        <Label.Style>
                                            <Style TargetType="Label" BasedOn="{StaticResource LabelDefault}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=IsOver}" Value="True">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                </uc:AutoGrid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Button Content="购买或续费" Margin="-5" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"
                    Background="Transparent"
                    BorderThickness="0"
                    pu:ButtonHelper.HoverForeground="{DynamicResource PrimaryBrush}"
                    Command="{Binding Path=BuyCommand}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextDecorations="Underline" />
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
            <Button Content="登出"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding Path=LogoutCommand}"
                    HorizontalAlignment="Stretch">
            </Button>
        </uc:AutoGrid>
    </Border>
</Page>