<pu:WindowX x:Class="Oddob.Service.View.Account.AccountWpf"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:pu="https://opensource.panuon.com/wpf-ui"
            xmlns:vm="clr-namespace:Oddob.Service.ViewModel.Account"
            xmlns:cvt="clr-namespace:Oddob.Service.View.Converter"
            d:DataContext="{d:DesignInstance Type=vm:AccountViewModel}"
            mc:Ignorable="d"
            x:Name="Window"
            Title="{Binding Path=Title}" Height="500" Width="900" MinHeight="500" MinWidth="350"
            WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
            pu:WindowXCaption.Buttons="Close"
            Background="Transparent"
            AllowsTransparency="true"
            WindowStyle="None"
            Icon="../../Resources/logo.ico"
            pu:IconHelper.Width="0">
    <pu:WindowXCaption.HeaderTemplate>
        <DataTemplate>
            <TextBlock Text="" VerticalAlignment="Center" Margin="20,0,0,0"></TextBlock>
        </DataTemplate>
    </pu:WindowXCaption.HeaderTemplate>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Oddob.Service;component/View/WpfTheme/PanuonUiThemeDefaultResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <cvt:SizeToRectConverter x:Key="SizeToRectConverter"></cvt:SizeToRectConverter>
        </ResourceDictionary>
    </Window.Resources>
    <Border CornerRadius="{StaticResource BigCorner}" Margin="0,-35,0,0">
        <Border.Background>
            <Brush>#FFFFFF</Brush>
        </Border.Background><Border.Clip>
            <RectangleGeometry RadiusX="8" RadiusY="8">
                <RectangleGeometry.Rect>
                    <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}"/>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Border}"/>
                    </MultiBinding>
                </RectangleGeometry.Rect>
            </RectangleGeometry>
        </Border.Clip>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>
            
             <Image Grid.Column="0" Source="../../Resources/login-left.png" Stretch="UniformToFill" />
            <Border Grid.Column="1" Background="White" CornerRadius="{StaticResource BigCorner}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label Grid.Column="0" Content="{Binding Path=Title}" Margin="20,0,0,0" VerticalAlignment="Center" Background="Transparent"/>
                    <Frame Grid.Row="1"
                           Content="{Binding Path=CurrentPage}"
                           NavigationUIVisibility="Hidden" />
                </Grid>
            </Border>
        </Grid>

    </Border>
</pu:WindowX>