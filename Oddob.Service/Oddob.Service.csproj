﻿<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <Nullable>enable</Nullable>
        <UseWpf>true</UseWpf>
        <UseWindowsForms>true</UseWindowsForms>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DebugType>full</DebugType>
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DebugType>none</DebugType>
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="DYH.Extensions.DependencyInjection" Version="9.0.5" />
        <PackageReference Include="Mapster" Version="7.2.0"/>
<!--        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3296.44" />-->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
        <PackageReference Include="Panuon.WPF.UI" Version="1.2.4.10" />
        <PackageReference Include="System.Management" Version="9.0.5" />
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="System.Net.Http" Condition="'$(TargetFramework)' == 'net48'">
        <HintPath>C:\Users\Administrator\.nuget\packages\microsoft.netframework.referenceassemblies.net48\1.0.3\build\.NETFramework\v4.8\System.Net.Http.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <None Remove="Resources\iconfont.ttf" />
      <Resource Include="Resources\iconfont.ttf" />
      <None Remove="Resources\logo.png" />
      <Resource Include="Resources\logo.png" />
      <None Remove="Resources\logo.ico" />
      <Resource Include="Resources\logo.ico" />
      <None Remove="Resources\login-left.png" />
      <Resource Include="Resources\login-left.png" />
    </ItemGroup>
</Project>
